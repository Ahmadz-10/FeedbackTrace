{
  "name": "feedbacktrace",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace @feedbacktrace/api",
    "dev:worker": "npm run start:worker:dev --workspace @feedbacktrace/api",
    "dev:web": "npm run dev --workspace @feedbacktrace/web",
    "db:generate": "npm run db:generate --workspace @feedbacktrace/database",
    "db:migrate": "npm run db:migrate --workspace @feedbacktrace/database",
    "db:studio": "npm run db:studio --workspace @feedbacktrace/database",
    "db:seed:staff": "npm run seed:staff --workspace @feedbacktrace/api",
    "build:contracts": "npm run build --workspace @feedbacktrace/contracts",
    "build:database": "npm run build --workspace @feedbacktrace/database",
    "build:api": "npm run build --workspace @feedbacktrace/api",
    "build:web": "npm run build --workspace @feedbacktrace/web",
    "build": "npm run build:contracts && npm run db:generate && npm run build:database && npm run build:api && npm run build:web",
    "test": "npm run test --workspace @feedbacktrace/api"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "tsx": "^4.19.3"
  }
}
